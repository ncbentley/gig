# Key list for the Infisical prod environment. deploy/render-env.sh writes
# deploy/.env on the server from that environment. Never commit the rendered file.

# Encrypts the Telegram session and API keys stored in the database. Keep it
# stable: changing it means signing in to Telegram again.
APP_SECRET=
POSTGRES_PASSWORD=
# Public address, used in emails and Stripe redirects.
APP_URL=https://goldintelligencegateway.com

# Ad bot. Not the user account that reads channels. Unset leaves
# POST /api/telegram/ad-bot at 503. Register once with pnpm telegram:ad-bot.
TELEGRAM_AD_BOT_TOKEN=
TELEGRAM_AD_BOT_WEBHOOK_SECRET=

# Used only when the database is empty. 12+ characters.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
# Shared secret for POST /api/v1/ingest/:slug.
INGEST_TOKEN=
# One bearer for GET /api/v1/research/feed. Unset leaves that route at 503.
# Generate with pnpm research:token and store the value here. Share it once,
# out of band. Replacing it revokes the previous value.
RESEARCH_FEED_TOKEN=

# Verification and password-reset mail. The domain goldintelligencegateway.com
# is verified in Resend. onboarding@resend.dev is ignored.
RESEND_API_KEY=
EMAIL_FROM=Gold Intelligence Gateway <noreply@goldintelligencegateway.com>

# Stripe billing and webhook verification (required in production unless ALLOW_MOCK_BILLING=1).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC_MONTHLY=
STRIPE_PRICE_SILVER_MONTHLY=
STRIPE_PRICE_GOLD_MONTHLY=

# 64-character hex key from Aetherion GIG Community → Developer connection.
# Unset skips enqueue. Outbox rows are still written for qualifying events.
# AETHERION_GIG_ACTIVITY_KEY=

# Fallbacks for /admin/settings.
MARKET_DATA_PROVIDER=twelvedata
TWELVEDATA_API_KEY=
AI_PROVIDER=deepinfra
DEEPINFRA_API_KEY=
# Concurrent chat completions on the DeepInfra account. Signal writeups use
# whatever message review, source writeups, the board, and the direction note
# do not reserve. Set this to the new cap after an increase is approved.
# DEEPINFRA_CONCURRENCY=200

# Named tunnel gold-intelligence-gateway. cloudflared runs on the VPS and
# forwards goldintelligencegateway.com to http://caddy:80. Leave TUNNEL_TOKEN
# empty only for a temporary quick tunnel; deploy.sh then rewrites APP_URL.
TUNNEL_COMMAND=tunnel --no-autoupdate run
# TUNNEL_TOKEN=
SITE_ADDRESS=http://goldintelligencegateway.com

# PostHog project API key. Unset skips forwarding. Product events still land in
# Postgres. Page views and revenue are sent only to PostHog.
# POSTHOG_API_KEY=
# US cloud is the default. EU cloud is https://eu.i.posthog.com
# POSTHOG_HOST=https://us.i.posthog.com
